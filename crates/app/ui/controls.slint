// Themed controls in the CashFlow green. The standard widgets take their
// accent color from the operating system (usually blue), so the interactive
// elements are implemented here with the brand colors.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconKind } from "icons.slint";

export enum ButtonKind { primary, secondary, danger, ghost, light }

// Push button. `primary` = filled green, `secondary` = green outline,
// `danger` = red outline, `ghost` = text only (on green), `light` = white on green.
export component CfButton inherits Rectangle {
    in property <string> text;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <IconKind> icon: IconKind.none;
    in property <bool> enabled: true;
    in property <bool> compact;
    callback clicked();

    property <bool> hovered: touch.has-hover && root.enabled;
    property <bool> pressed: touch.pressed && root.enabled;
    property <color> fg: !root.enabled ? Theme.placeholder
        : root.kind == ButtonKind.primary ? white
        : root.kind == ButtonKind.danger ? Theme.error
        : root.kind == ButtonKind.ghost ? white
        : root.kind == ButtonKind.light ? Theme.brand-dark
        : Theme.brand-dark;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    forward-focus: focus;
    min-height: root.compact ? 30px : Theme.control-height;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    background: !root.enabled ? #e6ebe8
        : root.kind == ButtonKind.primary ? (root.pressed ? Theme.brand-darker : root.hovered ? Theme.brand-dark : Theme.brand)
        : root.kind == ButtonKind.danger ? (root.pressed ? #f7d6d3 : root.hovered ? Theme.error-light : Theme.surface)
        : root.kind == ButtonKind.ghost ? (root.pressed ? #ffffff33 : root.hovered ? #ffffff1f : transparent)
        : root.kind == ButtonKind.light ? (root.pressed ? Theme.brand-light : root.hovered ? Theme.brand-lighter : white)
        : (root.pressed ? Theme.brand-light : root.hovered ? Theme.brand-lighter : Theme.surface);
    border-width: (root.kind == ButtonKind.secondary || root.kind == ButtonKind.danger) ? 1px : 0px;
    border-color: !root.enabled ? Theme.border : root.kind == ButtonKind.danger ? Theme.error : Theme.brand;
    drop-shadow-blur: root.kind == ButtonKind.primary && root.enabled ? (root.hovered ? 10px : 6px) : 0px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #267f3f47;
    animate background, drop-shadow-blur { duration: 120ms; }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    row := HorizontalLayout {
        padding-left: root.compact ? 10px : 16px;
        padding-right: root.compact ? 10px : 16px;
        spacing: 6px;
        alignment: center;
        if root.icon != IconKind.none: VerticalLayout {
            alignment: center;
            Icon {
                kind: root.icon;
                size: 18px;
                fill: root.fg;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: Theme.brand.with-alpha(0.55);
    }
}

// Round icon-only button (close, previous/next …).
export component IconButton inherits Rectangle {
    in property <IconKind> icon;
    in property <color> icon-color: Theme.text-muted;
    in property <length> size: 32px;
    in property <string> tooltip;
    callback clicked();
    accessible-role: button;
    accessible-label: root.tooltip;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.pressed ? #00000024 : touch.has-hover ? #00000012 : transparent;
    animate background { duration: 100ms; }
    Icon {
        kind: root.icon;
        size: root.size * 0.6;
        fill: root.icon-color;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Single-line text input with a green focus border and a red error state.
export component CfLineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> read-only <=> input.read-only;
    in property <bool> enabled <=> input.enabled;
    in property <InputType> input-type <=> input.input-type;
    in property <TextHorizontalAlignment> horizontal-alignment <=> input.horizontal-alignment;
    in property <bool> has-error;
    in property <IconKind> icon: IconKind.none;
    out property <bool> has-focus: input.has-focus;
    callback edited(text: string);
    callback accepted(text: string);
    public function focus-input() {
        input.focus();
    }

    property <length> text-start: root.icon != IconKind.none ? 36px : 12px;

    accessible-role: text-input;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;
    forward-focus: input;
    min-width: 80px;
    min-height: Theme.control-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    background: input.read-only || !input.enabled ? Theme.surface-alt : Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: root.has-error ? Theme.error : input.has-focus ? Theme.brand : hover.has-hover ? Theme.border-strong : Theme.border;
    animate border-color { duration: 120ms; }

    hover := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }
    if root.icon != IconKind.none: Icon {
        x: 11px;
        y: (parent.height - self.height) / 2;
        kind: root.icon;
        size: 18px;
        fill: input.has-focus ? Theme.brand : Theme.placeholder;
    }
    Rectangle {
        x: root.text-start;
        width: parent.width - root.text-start - 12px;
        clip: true;
        Text {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            horizontal-alignment: input.horizontal-alignment;
            text: input.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
            color: Theme.placeholder;
            accessible-role: none;
        }
        ContextMenuArea {
            enabled: input.enabled;
            Menu {
                MenuItem {
                    title: "Ausschneiden";
                    enabled: !input.read-only;
                    activated => {
                        input.cut();
                    }
                }
                MenuItem {
                    title: "Kopieren";
                    activated => {
                        input.copy();
                    }
                }
                MenuItem {
                    title: "Einfügen";
                    enabled: !input.read-only;
                    activated => {
                        input.paste();
                    }
                }
                MenuItem {
                    title: "Alles auswählen";
                    activated => {
                        input.select-all();
                    }
                }
            }
            input := TextInput {
                property <length> computed-x;
                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                selection-background-color: Theme.brand-light;
                selection-foreground-color: Theme.text;
                accessible-role: none;
                cursor-position-changed(position) => {
                    if position.x + self.computed-x < 0px {
                        self.computed-x = - position.x;
                    } else if position.x + self.computed-x > parent.width - self.text-cursor-width {
                        self.computed-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
            }
        }
    }
}

// Drop-down selection.
export component CfComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    in property <bool> enabled: true;
    in property <string> placeholder-text: "– bitte wählen –";
    callback selected(value: string);

    property <length> item-height: 32px;

    function choose(index: int) {
        if index >= 0 && index < root.model.length && index != root.current-index {
            root.current-index = index;
            root.selected(root.model[index]);
        }
    }

    accessible-role: combobox;
    accessible-value: root.current-value;
    accessible-enabled: root.enabled;
    forward-focus: focus;
    min-width: 120px;
    min-height: Theme.control-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    background: !root.enabled ? Theme.surface-alt : touch.has-hover ? Theme.brand-lighter : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.brand : touch.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: 120ms; }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.DownArrow {
                root.choose(root.current-index + 1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.choose(root.current-index - 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                popup.show();
                return accept;
            }
            reject
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.current-value != "" ? root.current-value : root.placeholder-text;
            color: !root.enabled ? Theme.placeholder : root.current-value != "" ? Theme.text : Theme.placeholder;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                kind: IconKind.chevron-down;
                size: 20px;
                fill: root.enabled ? Theme.brand : Theme.placeholder;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(root.model.length * root.item-height + 10px, 320px);
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.control-radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #0000002e;
            ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                for item[index] in root.model: Rectangle {
                    height: root.item-height;
                    border-radius: 5px;
                    background: index == root.current-index ? Theme.brand-light : row-touch.has-hover ? Theme.surface-alt : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: item;
                            vertical-alignment: center;
                            color: index == root.current-index ? Theme.brand-dark : Theme.text;
                            font-weight: index == root.current-index ? 700 : 400;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if index == root.current-index: VerticalLayout {
                            alignment: center;
                            Icon {
                                kind: IconKind.check;
                                size: 16px;
                                fill: Theme.brand;
                            }
                        }
                    }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.choose(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Check box with a label; the label is clickable too.
export component CfCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled();
    }
    min-height: 26px;
    HorizontalLayout {
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: root.checked ? Theme.brand : Theme.surface;
                border-width: root.checked ? 0px : 1.5px;
                border-color: touch.has-hover ? Theme.brand : Theme.border-strong;
                animate background { duration: 120ms; }
                if root.checked: Icon {
                    kind: IconKind.check;
                    size: 14px;
                    fill: white;
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? Theme.text : Theme.placeholder;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// On/off switch with a label.
export component CfSwitch inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled();
    }
    min-height: 28px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: root.checked ? Theme.brand : #c5cfc9;
                animate background { duration: 150ms; }
                Rectangle {
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: white;
                    drop-shadow-blur: 3px;
                    drop-shadow-color: #00000040;
                    animate x {
                        duration: 150ms;
                        easing: ease-in-out;
                    }
                }
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? Theme.text : Theme.placeholder;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// Three pulsing dots ("working …").
export component CfSpinner inherits HorizontalLayout {
    in property <color> color: Theme.brand;
    spacing: 4px;
    alignment: center;
    for i in 3: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.color;
            opacity: 0.25 + 0.75 * abs(sin(animation-tick() / 1000ms * 220deg + i * 45deg));
        }
    }
}
