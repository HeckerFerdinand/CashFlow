// Design tokens. Colors follow the old app (brand green #267f3f,
// blue for wage records, orange for time records).
export global Theme {
    out property <color> brand: #267f3f;
    out property <color> brand-dark: #1b5e2f;
    out property <color> brand-light: #e6f1e9;
    out property <color> background: #f3f5f4;
    out property <color> surface: #ffffff;
    out property <color> surface-alt: #f7f9f8;
    out property <color> border: #dce2de;
    out property <color> text: #1b2420;
    out property <color> text-muted: #5e6a64;
    out property <color> error: #b3261e;
    out property <color> error-light: #fbeaea;
    out property <color> success: #2e7d32;
    out property <color> success-light: #e8f4e9;
    out property <color> info-light: #e8eef9;
    out property <color> payroll: #4f6bed;
    out property <color> time: #f08a4b;
    out property <length> radius: 8px;
    out property <length> gap: 12px;
    out property <length> page-padding: 24px;
    out property <length> font-small: 12px;
    out property <length> font-normal: 14px;
    out property <length> font-heading: 16px;
    out property <length> font-title: 22px;
}
