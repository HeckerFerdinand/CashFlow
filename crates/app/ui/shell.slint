// Window chrome inside the app: navigation sidebar, busy indicator,
// notifications and the confirmation dialog.

import { Button, Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Nav, Page, AppState, Notices, Notice, NoticeKind, Confirm } from "state.slint";
import { Card } from "widgets.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <Page> page;
    property <bool> active: Nav.page == root.page;
    min-height: 36px;
    border-radius: 6px;
    background: root.active ? #ffffff2e : touch.has-hover ? #ffffff14 : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Nav.navigate(root.page);
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: white;
            font-weight: root.active ? 700 : 400;
            overflow: elide;
        }
    }
}

component NavGroup inherits Text {
    color: #ffffffa8;
    font-size: 11px;
    font-weight: 600;
}

export component Sidebar inherits Rectangle {
    background: Theme.brand;
    min-width: 190px;
    preferred-width: 220px;
    max-width: 240px;
    horizontal-stretch: 0;
    VerticalLayout {
        padding: 14px;
        padding-top: 18px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            padding-bottom: 14px;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                background: white;
                Image {
                    source: @image-url("../../../assets/logo.png");
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                }
            }
            Text {
                text: "CashFlow";
                color: white;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        NavGroup {
            text: "LOHNBUCHHALTUNG";
        }
        NavItem {
            label: "Übersicht";
            page: Page.overview;
        }
        NavItem {
            label: "Lohnerfassung";
            page: Page.payroll;
        }
        NavItem {
            label: "Zeiterfassung";
            page: Page.time;
        }
        NavItem {
            label: "Dokumente";
            page: Page.documents;
        }
        Rectangle {
            height: 10px;
        }
        NavGroup {
            text: "STAMMDATEN";
        }
        NavItem {
            label: "Mitarbeiter";
            page: Page.employees;
        }
        NavItem {
            label: "Arbeitgeber";
            page: Page.employers;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        NavItem {
            label: "Einstellungen";
            page: Page.settings;
        }
        NavItem {
            label: "Info";
            page: Page.about;
        }
        Rectangle {
            height: 1px;
            background: #ffffff33;
        }
        Text {
            text: AppState.user-email;
            color: #ffffffcc;
            font-size: 11px;
            overflow: elide;
        }
        TouchArea {
            mouse-cursor: pointer;
            height: 24px;
            clicked => {
                AppState.sign-out();
            }
            Text {
                text: "Abmelden";
                color: white;
                font-size: 12px;
                horizontal-alignment: left;
                width: 100%;
            }
        }
    }
}

// Small floating "working…" indicator (top right).
export component BusyIndicator inherits Rectangle {
    visible: AppState.busy;
    border-radius: 16px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #0000001f;
    width: row.preferred-width;
    height: 32px;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 8px;
        Spinner {
            indeterminate: true;
            width: 18px;
            height: 18px;
            y: 7px;
        }
        Text {
            text: AppState.busy-text == "" ? "Bitte warten …" : AppState.busy-text;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.font-small;
        }
    }
}

component NoticeView inherits Rectangle {
    in property <Notice> notice;
    border-radius: 8px;
    background: root.notice.kind == NoticeKind.error ? Theme.error-light : root.notice.kind == NoticeKind.success ? Theme.success-light : Theme.info-light;
    border-width: 1px;
    border-color: root.notice.kind == NoticeKind.error ? Theme.error : root.notice.kind == NoticeKind.success ? Theme.success : Theme.border;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000026;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Text {
            text: root.notice.text;
            wrap: word-wrap;
            color: Theme.text;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        TouchArea {
            width: 20px;
            mouse-cursor: pointer;
            clicked => {
                Notices.dismiss(root.notice.id);
            }
            Text {
                text: "✕";
                color: Theme.text-muted;
                vertical-alignment: top;
            }
        }
    }
}

// Stack of notifications in the bottom right corner.
export component NoticeStack inherits VerticalLayout {
    spacing: 8px;
    alignment: end;
    for notice in Notices.items: NoticeView {
        notice: notice;
    }
}

// Modal confirmation ("Wirklich löschen?").
export component ConfirmDialog inherits Rectangle {
    background: #00000059;
    TouchArea { }
    Card {
        width: min(460px, root.width - 32px);
        height: self.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        pad: 22px;
        gap: 14px;
        Text {
            text: Confirm.title;
            font-size: Theme.font-heading;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: Confirm.message;
            color: Theme.text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Abbrechen";
                clicked => {
                    Confirm.rejected();
                }
            }
            Button {
                text: Confirm.confirm-label;
                primary: true;
                clicked => {
                    Confirm.accepted();
                }
            }
        }
    }
}
